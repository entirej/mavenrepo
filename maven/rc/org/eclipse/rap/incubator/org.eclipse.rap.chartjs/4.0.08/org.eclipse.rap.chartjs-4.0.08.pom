<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.eclipse.rap.incubator</groupId>
    <artifactId>org.eclipse.rap.chartjs</artifactId>
    <version>4.0.08</version>
    <name>RAP Chart.js Widget</name>
    <description>Chart.js 4 custom widget for Eclipse RAP</description>
    <url>https://github.com/entirej/rap/tree/develop/rap-chartjs</url>

    <licenses>
        <license>
            <name>Eclipse Public License 1.0</name>
            <url>https://www.eclipse.org/legal/epl-v10.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/entirej/rap.git</connection>
        <developerConnection>scm:git:https://github.com/entirej/rap.git</developerConnection>
        <url>https://github.com/entirej/rap/tree/develop/rap-chartjs</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <rap.version>4.7.0</rap.version>
        <MAVEN.REPO.PATH>development</MAVEN.REPO.PATH>
        <GITHUB.OAUTH></GITHUB.OAUTH>
        <built.repo.dir>${project.build.directory}/repo</built.repo.dir>
    </properties>

    <build>
        <sourceDirectory>bundles/org.eclipse.rap.chartjs/src</sourceDirectory>
        <resources>
            <resource>
                <directory>bundles/org.eclipse.rap.chartjs/src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>bundles/org.eclipse.rap.chartjs/docs</directory>
                <targetPath>docs</targetPath>
            </resource>
            <resource>
                <directory>.</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestFile>bundles/org.eclipse.rap.chartjs/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <release>21</release>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <altDeploymentRepository>internal.repo::file://${built.repo.dir}</altDeploymentRepository>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.github</groupId>
                <artifactId>site-maven-plugin</artifactId>
                <version>0.12</version>
                <configuration>
                    <message>Maven artifacts for ${project.groupId}:${project.artifactId}:${project.version} ~${maven.build.timestamp}</message>
                    <noJekyll>true</noJekyll>
                    <outputDirectory>${built.repo.dir}</outputDirectory>
                    <merge>true</merge>
                    <repositoryOwner>entirej</repositoryOwner>
                    <repositoryName>mavenrepo</repositoryName>
                    <branch>refs/heads/gh-pages</branch>
                    <path>maven/${MAVEN.REPO.PATH}</path>
                    <oauth2Token>${GITHUB.OAUTH}</oauth2Token>
                    <includes>
                        <include>**/*</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>publish-development-repository</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>site</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.rap</groupId>
            <artifactId>org.eclipse.rap.rwt</artifactId>
            <version>${rap.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
	<!-- Run with: mvn verify -Ptrivy-scan [-Dtrivy.executable=/path/to/trivy] -->
	<profiles>
		<profile>
			<id>trivy-scan</id>
			<properties>
				<trivy.executable>trivy</trivy.executable>
				<trivy.severity>CRITICAL,HIGH</trivy.severity>
				<trivy.exitCode>1</trivy.exitCode>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.cyclonedx</groupId>
						<artifactId>cyclonedx-maven-plugin</artifactId>
						<version>2.9.3</version>
						<executions>
							<execution>
								<id>generate-trivy-sbom</id>
								<phase>verify</phase>
								<goals>
									<goal>makeBom</goal>
								</goals>
								<configuration>
									<outputFormat>json</outputFormat>
									<outputName>trivy-sbom</outputName>
									<includeProvidedScope>false</includeProvidedScope>
									<includeSystemScope>false</includeSystemScope>
									<includeTestScope>false</includeTestScope>
									<skipAttach>true</skipAttach>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.3</version>
						<executions>
							<execution>
								<id>trivy-scan-dependencies</id>
								<phase>verify</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${trivy.executable}</executable>
									<arguments>
										<argument>sbom</argument>
										<argument>--scanners</argument>
										<argument>vuln</argument>
										<argument>--severity</argument>
										<argument>${trivy.severity}</argument>
										<argument>--exit-code</argument>
										<argument>${trivy.exitCode}</argument>
						<argument>--no-progress</argument>
						<argument>--quiet</argument>
						<argument>--format</argument>
										<argument>json</argument>
										<argument>--output</argument>
										<argument>${project.build.directory}/trivy-report.json</argument>
										<argument>${project.build.directory}/trivy-sbom.json</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
